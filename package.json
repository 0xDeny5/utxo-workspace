{
  "name": "utxo-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Accurate, dependency-free UTXO primitives for TypeScript — coin selection, descriptors, and related libraries",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "benchmark": "tsx benchmarks/compare.ts",
    "build": "pnpm -r build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "commitlint": "commitlint",
    "coverage": "pnpm -r coverage",
    "docs": "typedoc",
    "examples": "pnpm --filter utxo-coinselect-example-node start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint-staged": "lint-staged",
    "mutation": "pnpm -r mutation",
    "prepare": "husky",
    "release": "pnpm check && pnpm coverage && changeset publish",
    "size": "size-limit",
    "test": "pnpm -r test",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@bitcoinerlab/coinselect": "^2.0.1",
    "@bitcoinerlab/descriptors": "^3.1.7",
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^12.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "coinselect": "^3.1.13",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "size-limit": "^12.1.0",
    "tinybench": "^6.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "path": "packages/utxo-coinselect/dist/index.js",
      "limit": "20 kB"
    }
  ]
}
