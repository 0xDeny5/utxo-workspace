{
  "name": "utxo-coinselect",
  "version": "0.1.4",
  "description": "Dependency-free, weight-aware Bitcoin UTXO coin selection",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/0xDeny5/utxo-workspace.git",
    "directory": "packages/utxo-coinselect"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./strategies": {
      "import": {
        "types": "./dist/strategies.d.ts",
        "default": "./dist/strategies.js"
      },
      "require": {
        "types": "./dist/strategies.d.cts",
        "default": "./dist/strategies.cjs"
      }
    },
    "./weights": {
      "import": {
        "types": "./dist/weights.d.ts",
        "default": "./dist/weights.js"
      },
      "require": {
        "types": "./dist/weights.d.cts",
        "default": "./dist/weights.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "utxo-coinselect",
    "bitcoin",
    "coin-selection",
    "coinselect",
    "utxo",
    "branch-and-bound",
    "taproot",
    "segwit",
    "typescript"
  ],
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "vitest": "^4.1.10"
  }
}
